# Federal Statistical Office (Destatis GENESIS) API credentials
# Register at: https://www-genesis.destatis.de/datenbank/online
DESTATIS_USERNAME=your_username_here
DESTATIS_API_TOKEN=your_api_token_here

# Optional: only needed if a curated table lives on Regionalstatistik.de, not GENESIS-Online (see D-15)
# Register at: https://www.regionalstatistik.de/genesis/online (state statistical offices)
# Note: unlike Destatis GENESIS-Online, Regionalstatistik.de does not offer an API-token
# registration flow -- this is classic HTTP username+password auth, not a token.
REGIONALSTATISTIK_USERNAME=
REGIONALSTATISTIK_PASSWORD=

# CARTO basemap API key for the React app (app/src/lib/basemap.js).
# Register at: https://carto.com/basemaps/apikey/ -- free for research/teaching/non-profits,
# 5 million tile requests per calendar month, no CARTO account needed.
# Without it CARTO serves tiles with an "API KEY REQUIRED" watermark burned into the PNG and
# the app silently falls back to OpenStreetMap's standard tiles.
# Vite reads this file via `envDir` in app/vite.config.js. The VITE_ prefix is required for
# the value to reach client code -- and is why the credentials above never enter the bundle.
# NOTE: this is a static SPA, so the key is embedded in the built JS and is visible in every
# tile request. Keeping it here only keeps it out of git; rotate it at carto.com if abused.
# CI: set the same value as the CARTO_API_KEY repository secret (.github/workflows/deploy-pages.yml).
VITE_CARTO_API_KEY=your_carto_api_key_here
